# BingX API Credentials (Required)
BINGX_API_KEY=your_bingx_api_key_here
BINGX_API_SECRET=your_bingx_api_secret_here

# Optional Configurations
BINGX_BASE_URL=https://open-api.bingx.com
FLASK_ENV=production
PORT=5000

# Automated Telegram Database Backup (Optional)
# Get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_numeric_chat_id_here

